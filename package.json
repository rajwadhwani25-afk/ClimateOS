{
  "name": "climateos",
  "version": "0.1.0",
  "description": "AI-Powered Climate Disaster Intelligence & Response Platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"FRONTEND,BACKEND\" -c \"cyan.bold,green.bold\" --kill-others-on-fail \"vite\" \"python -m uvicorn services.main:app --reload --port 8000\"",
    "frontend": "vite",
    "backend": "python -m uvicorn services.main:app --reload --port 8000",
    "test:backend": "python -m pytest tests/test_api.py -v"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "concurrently": "^9.0.0"
  }
}
